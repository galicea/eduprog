# react (react 18 to ostatnia wersja z UMD - kopiowane do dist/js):
npm install --save-dev react@^18 react-dom@^18

# babel + gulp 4:
npm install --save-dev @babel/core @babel/preset-env @babel/preset-react
npm install --save-dev gulp gulp-babel

# budowa (kopiuje react UMD, kompiluje JSX -> dist/js, kopiuje index.html -> dist):
npx gulp