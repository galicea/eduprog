# pusty package.json:
npm init -y

# react (bundle'owanie przez webpack - react trafi razem z kodem do helloworld.js):
npm install --save-dev react react-dom

# babel 7 (@babel/preset-react 8/9 zmienia domyślny runtime JSX - potrzebne 7):
npm install --save-dev @babel/core@^7 @babel/preset-env@^7 @babel/preset-react@^7 babel-loader

# webpack 5:
npm install --save-dev webpack webpack-cli

# budowa bundla (tworzy helloworld.js):
npx webpack