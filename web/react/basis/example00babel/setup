# pusty package.json:
npm init -y

# react (buildy UMD: node_modules/react/umd) — react 18 to ostatnia wersja z UMD:
npm install --save-dev react@^18 react-dom@^18

# kompilator babel (wersja 7; @babel/cli 8 wymaga @babel/core 8, a tu potrzebne 7):
npm install --save-dev @babel/cli@^7 @babel/core@^7 @babel/preset-env@^7 @babel/preset-react@^7

# kompilacja JSX -> helloworld.js:
./build